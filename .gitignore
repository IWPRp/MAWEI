# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store

# data - raw CSVs for bulky files kept in main_csvs/
data/all_csvs/
# ignore bulky raw CSVs (only their .gz versions are tracked)

# the full SEDS national file is never tracked (only the GA extract is)
data/eia_seds_Complete_*.csv.gz

# folders
# Hidden files are ignored wholesale, but .github must be tracked or the Pages
# workflow never reaches GitHub.
.*
!.github/
!.gitignore
!.nojekyll

# Generated outputs are regenerable and large (~247 MB, mostly self-contained HTML
# with an embedded copy of plotly in each file), so the tree is not tracked -- except
# the Sankey JSON, which is the payload GitHub Pages serves and is only ~2.3 MB.
# Git cannot re-include a file whose parent directory is excluded, so each level is
# excluded by contents (dir/*) rather than as a directory (dir/), leaving the
# negations below able to take effect.
outputs/*
!outputs/files/
outputs/files/*
!outputs/files/manifest.json
!outputs/files/manifest.js
!outputs/files/energy/
!outputs/files/water/
!outputs/files/energy-water/
outputs/files/*/*
!outputs/files/*/*.json

# QC + scratch output trees (regenerable)
outputs/qc/
outputs/files_baseline/
outputs/files_p1/
outputs/files_check/
outputs/*.log

# The dashboard reads artefacts through a symlink created by web/serve.command.
web/data

docs_analysis/
AGENTS.md
# Large upstream reference datasets. None is tracked. Each is reduced to the study region by a
# prep script, and only the small extract is committed -- so if a file appears below, the extract
# beside it is what the analysis actually reads.
#
#   source (ignored)                          prep script        committed extract
#   WBD_03_HU2_GPKG/            365 MB        R/prep_spatial.R   spatial_basins.geojson    30 kB
#                                                                spatial_county_basin_area.csv
#   WRP Permit Inventory *.xlsx 190 kB        R/prep_spatial.R   spatial_facility_coords.csv
#   ACS_2022_5YR_TRACT_13_*.gdb 1.0 GB        R/prep_acs.R       acs_tract_metro.csv      390 kB
#                                                                acs_tract_metro.geojson  680 kB
#   datacenter_atlas/            26 MB        R/analysis.R       H1-H4 tables in
#   datacenter_atlas_*.zip        27 MB                          docs_analysis/analysis_outputs/
#   epa_npdes_outfalls_layer     49 MB        R/analysis.R       G1 validation tables
#   cb_2025_13_tract_500k/      4.4 MB        superseded by prep_acs.R -- geometry only, no
#                                            population, retained only for R/figures.R fallback
data/WBD_03_HU2_GPKG/
data/WRP Permit Inventory *.xlsx
data/ACS_2022_5YR_TRACT_13_GEORGIA.gdb/
data/ACS_2021_Manifest.xls
data/datacenter_atlas/
data/datacenter_atlas_*.zip
data/epa_npdes_outfalls_layer.csv.gz
data/cb_2025_13_tract_500k/
