# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store

# data - raw CSVs for bulky files kept in main_csvs/
data/all_csvs/
# ignore bulky raw CSVs (only their .gz versions are tracked)

# the full SEDS national file is never tracked (only the GA extract is)
data/eia_seds_Complete_*.csv.gz

# folders
# Hidden files are ignored wholesale, but .github must be tracked or the Pages
# workflow never reaches GitHub.
.*
!.github/
!.gitignore
!.nojekyll

# Generated outputs are regenerable and large (~247 MB, mostly self-contained HTML
# with an embedded copy of plotly in each file), so the tree is not tracked -- except
# the Sankey JSON, which is the payload GitHub Pages serves and is only ~2.3 MB.
# Git cannot re-include a file whose parent directory is excluded, so each level is
# excluded by contents (dir/*) rather than as a directory (dir/), leaving the
# negations below able to take effect.
outputs/*
!outputs/files/
outputs/files/*
!outputs/files/manifest.json
!outputs/files/manifest.js
!outputs/files/energy/
!outputs/files/water/
!outputs/files/energy-water/
outputs/files/*/*
!outputs/files/*/*.json

# QC + scratch output trees (regenerable)
outputs/qc/
outputs/files_baseline/
outputs/files_p1/
outputs/files_check/
outputs/*.log

# The dashboard reads artefacts through a symlink created by web/serve.command.
web/data

docs_analysis/
# Large upstream reference datasets. Each is filtered to the study region by R/prep_spatial.R,
# and only the small extract is tracked: spatial_basins.geojson (30 kB from a 365 MB
# geopackage), spatial_facility_coords.csv, spatial_county_basin_area.csv.
data/WBD_03_HU2_GPKG/
data/datacenter_atlas/
data/epa_npdes_outfalls_layer.csv.gz
data/WRP Permit Inventory *.xlsx
